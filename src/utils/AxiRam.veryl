// シミュレーション用のAXI RAMモジュール
// 実際に合成するとクソデカRAMが合成される可能性が高いので注意
module AxiRam #(
    param DEPTH: u32 = 4096,
) (
    i_clk              : input  clock    ,
    i_rst              : input  reset    ,
    mem_read_if_arvalid: input  logic    ,
    mem_read_if_arready: output logic    ,
    mem_read_if_araddr : input  Addr     ,
    mem_read_if_arid   : input  Id       ,
    mem_read_if_arlen  : input  Len      ,
    mem_read_if_arsize : input  Size     ,
    mem_read_if_arburst: input  Burst    ,
    mem_read_if_rvalid : output logic    ,
    mem_read_if_rready : input  logic    ,
    mem_read_if_rdata  : output logic<32>,
    mem_read_if_rid    : output Id       ,
    mem_read_if_rresp  : output Resp     ,
    mem_read_if_rlast  : output logic    ,

    mem_write_if_awvalid: input  logic        ,
    mem_write_if_awready: output logic        ,
    mem_write_if_awaddr : input  Addr         ,
    mem_write_if_awid   : input  Id           ,
    mem_write_if_awlen  : input  Len          ,
    mem_write_if_awsize : input  Size         ,
    mem_write_if_awburst: input  Burst        ,
    mem_write_if_wvalid : input  logic        ,
    mem_write_if_wready : output logic        ,
    mem_write_if_wdata  : input  logic<32>    ,
    mem_write_if_wstrb  : input  logic<32 / 8>,
    mem_write_if_wlast  : input  logic        ,
) {
    import axi_pkg::*;
    import Config::*;

    var r_mem: logic<32> [DEPTH >> 2];

    var r_arready: logic                          ;
    var r_rvalid : logic                          ;
    var r_data   : logic<$bits(mem_read_if_rdata)>;
    var r_len    : Len                            ;
    var r_len_cnt: Len                            ;
    var r_addr   : Addr                           ;

    var r_awready : logic;
    var r_wready  : logic;
    var r_wlen    : Len  ;
    var r_wlen_cnt: Len  ;
    var r_waddr   : Addr ;

    initial {
        // $readmemh("tmp_inst.hex", r_mem);
    }

    always_comb {
        mem_read_if_arready = r_arready;
        mem_read_if_rvalid  = r_rvalid;
        mem_read_if_rdata   = r_data;
        mem_read_if_rid     = '0;
        mem_read_if_rresp   = Resp::OKAY;
        mem_read_if_rlast   = (r_len == r_len_cnt) && r_rvalid;

        mem_write_if_awready = r_awready;
        mem_write_if_wready  = r_wready;
    }

    #[allow(missing_reset_statement)]
    always_ff (i_clk, i_rst) {
        if_reset {
            r_addr     = 0;
            r_data     = 0;
            r_rvalid   = 0;
            r_arready  = 1;
            r_len      = 0;
            r_len_cnt  = 0;
            r_awready  = 1;
            r_wready   = 0;
            r_wlen     = 0;
            r_wlen_cnt = 0;
            r_waddr    = 0;
        } else {
            // read interface
            if (mem_read_if_arvalid && r_arready) {
                r_rvalid = 1;
                if mem_read_if_arlen != 0 {
                    r_arready = 0;
                    r_len     = mem_read_if_arlen;
                    r_len_cnt = 0;
                    r_addr    = mem_read_if_araddr;
                }
                r_data = r_mem[mem_read_if_araddr as u32 >> 2];
            }
            if (mem_read_if_rready && r_rvalid && mem_read_if_rlast) {
                r_rvalid = mem_read_if_arvalid && r_arready;
            } else if (mem_read_if_rready && r_rvalid) {
                r_rvalid  =  1;
                r_data    =  r_mem[(r_addr as u32 >> 2) + (r_len_cnt as u32 + 1)];
                r_len_cnt += 1;
                r_arready =  1;
            }
            // write interface
            if (mem_write_if_awvalid && r_awready) {
                r_wready = 1;
                if mem_write_if_awlen != 0 {
                    r_awready  = 0;
                    r_wlen     = mem_write_if_awlen;
                    r_wlen_cnt = 0;
                    r_waddr    = mem_write_if_awaddr;
                }
            }
            if (mem_write_if_wvalid && r_wready) {
                r_mem[r_waddr + r_len_cnt as 32] = mem_write_if_wdata;
                if (mem_write_if_wlast) {
                    r_wready  = 0;
                    r_awready = 1;
                } else {
                    r_len_cnt += 1;
                }
            }
        }
    }
}
