// シミュレーション用のAXI RAMモジュール
// 実際に合成するとクソデカRAMが合成される可能性が高いので注意
module AxiRam #(
    param DEPTH: u32 = 4096,
) (
    i_clk   : input   clock              ,
    i_rst   : input   reset              ,
    read_if : modport axi_read_if::slave ,
    write_if: modport axi_write_if::slave,
) {
    import axi_pkg::*;
    import Config::*;

    var r_mem: logic<32> [DEPTH >> 2];

    var r_arready: logic                      ;
    var r_rvalid : logic                      ;
    var r_data   : logic<$bits(read_if.rdata)>;
    var r_len    : Len                        ;
    var r_len_cnt: Len                        ;
    var r_addr   : Addr                       ;

    var r_awready : logic;
    var r_awid    : Id   ;
    var r_wready  : logic;
    var r_wlen    : Len  ;
    var r_wlen_cnt: Len  ;
    var r_waddr   : Addr ;

    var r_bvalid: logic;
    var r_bid   : Id   ;
    var r_bresp : Resp ;

    // #[allow(initial_assign)]
    embed (inline) sv{{{
        initial begin
            $readmemh("tmp_data.hex", r_mem);
        end
    }}}

    always_comb {
        read_if.arready = r_arready;
        read_if.rvalid  = r_rvalid;
        read_if.rdata   = r_data;
        read_if.rid     = '0;
        read_if.rresp   = Resp::OKAY;
        read_if.rlast   = (r_len == r_len_cnt) && r_rvalid;

        write_if.awready = r_awready;
        write_if.wready  = r_wready;
    }

    #[allow(missing_reset_statement)]
    always_ff (i_clk, i_rst) {
        if_reset {
            r_addr     = 0;
            r_data     = 0;
            r_rvalid   = 0;
            r_arready  = 1;
            r_len      = 0;
            r_len_cnt  = 0;
            r_awready  = 1;
            r_wready   = 0;
            r_wlen     = 0;
            r_wlen_cnt = 0;
            r_waddr    = 0;
        } else {
            // read interface
            if read_if.ar_ack() {
                r_rvalid = 1;
                if read_if.arlen != 0 {
                    r_arready = 0;
                    r_len     = read_if.arlen;
                    r_len_cnt = 0;
                    r_addr    = read_if.araddr;
                }
                r_data = r_mem[read_if.araddr as u32 >> 2];
            }
            if read_if.r_ack() && read_if.rlast {
                r_rvalid = read_if.arvalid && r_arready;
            } else if read_if.r_ack() {
                r_rvalid  =  1;
                r_data    =  r_mem[(r_addr as u32 >> 2) + (r_len_cnt as u32 + 1)];
                r_len_cnt += 1;
                r_arready =  1;
            }
            // write interface
            if write_if.aw_ack() {
                r_wready = 1;
                r_awid   = write_if.awid;
                if write_if.awlen != 0 {
                    r_awready  = 0;
                    r_wlen     = write_if.awlen;
                    r_wlen_cnt = 0;
                    r_waddr    = write_if.awaddr;
                }
            }
            if write_if.w_ack() {
                r_mem[r_waddr + r_len_cnt as 32] = write_if.wdata;
                if (write_if.wlast) {
                    r_wready = 0;
                    r_bvalid = 1;
                    r_bid    = r_awid;
                    r_bresp  = Resp::OKAY;
                } else {
                    r_len_cnt += 1;
                }
            }
            if write_if.b_ack() {
                r_bvalid  = 0;
                r_awready = 1;
            }
        }
    }
}
