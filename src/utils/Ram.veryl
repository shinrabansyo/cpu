module Ram #(
    param DataType: type = logic<8> ,
    param AddrType: type = logic<10>,
) (
    i_clk: input clock,
    i_rst: input reset,

    i_addr : input  AddrType                           ,
    i_we   : input  logic                              ,
    i_wstrb: input  logic   <($bits(DataType) + 7) / 8>,
    i_data : input  DataType                           ,
    o_data : output DataType                           ,
) {
    var r_data     : DataType [1 << $bits(AddrType)];
    var r_read_data: DataType                       ;

    always_comb {
        o_data = r_read_data;
    }

    #[allow(missing_reset_statement)]
    always_ff (i_clk, i_rst) {
        if_reset {
            r_read_data = 0;
        } else {
            if (i_we) {
                r_data[i_addr] = i_data;
            }
            r_read_data = r_data[i_addr];
        }
    }
}
