module AxiRomWrapper (
    i_clk              : input  clock    ,
    i_rst              : input  reset    ,
    mem_read_if_arvalid: input  logic    ,
    mem_read_if_arready: output logic    ,
    mem_read_if_araddr : input  Addr     ,
    mem_read_if_arid   : input  Id       ,
    mem_read_if_arlen  : input  Len      ,
    mem_read_if_arsize : input  Size     ,
    mem_read_if_arburst: input  Burst    ,
    mem_read_if_rvalid : output logic    ,
    mem_read_if_rready : input  logic    ,
    mem_read_if_rdata  : output logic<32>,
    mem_read_if_rid    : output Id       ,
    mem_read_if_rresp  : output Resp     ,
    mem_read_if_rlast  : output logic    ,
) {
    import axi_pkg::*;
    import Config::*;

    inst read_if: axi_read_if;
    inst axi_rom: AxiRom (
        i_clk    ,
        i_rst    ,
        read_if  ,
    );

    always_comb {
        read_if.arvalid     = mem_read_if_arvalid;
        mem_read_if_arready = read_if.arready;
        read_if.araddr      = mem_read_if_araddr;
        read_if.arid        = mem_read_if_arid;
        read_if.arlen       = mem_read_if_arlen;
        read_if.arsize      = mem_read_if_arsize;
        read_if.arburst     = mem_read_if_arburst;
        mem_read_if_rvalid  = read_if.rvalid;
        read_if.rready      = mem_read_if_rready;
        mem_read_if_rdata   = read_if.rdata;
        mem_read_if_rid     = read_if.rid;
        mem_read_if_rresp   = read_if.rresp;
        mem_read_if_rlast   = read_if.rlast;
    }
}
