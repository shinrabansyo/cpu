interface core_icache_if {
    import Config::*;

    var valid      : logic; // fetch req
    var ready      : logic; // fetch req 受付可能
    var addr       : Addr ;
    var instr      : Inst ;
    var instr_valid: logic; // instr 有効

    // isb 命令用
    var wvalid: logic                 ;
    var waddr : Addr                  ;
    var wdata : Data                  ;
    var wstrb : logic<$bits(Data) / 8>;
    var wready: logic                 ;

    modport core_fetch {
        valid      : output,
        ready      : input ,
        addr       : output,
        instr      : input ,
        instr_valid: input ,
    }

    modport core_write {
        wvalid: output,
        waddr : output,
        wdata : output,
        wstrb : output,
        wready: input ,
    }

    modport icache_fetch {
        ..converse(core_fetch)
    }

    modport icache_write {
        ..converse(core_write)
    }
}
