interface core_icache_if {
    import Config::*;

    var valid: logic;
    var addr : Addr ;
    var instr: Inst ;
    var ready: logic;

    modport core {
        valid: output,
        addr : output,
        instr: input ,
        ready: input ,
    }

    modport icache {
        ..converse(core)
    }
}
