#[test(icache_tb)]
embed (inline) sv{{{
    module icache_tb();
        import \{ Config \}::*;
        import \{ axi_pkg \}::*;

        localparam int HOLD = 5;
        localparam int STEP = 20;

        localparam int CACHE_HIT_LATENCY = 2;
        localparam int CACHE_MISS_LATENCY = 4;

        \{ core_icache_if \} core_if();
        \{ axi_read_if \} #(
            .Addr(Addr),
            .Data(logic[31:0])
        ) read_if();
        \{ axi_write_if \} #(
            .Addr(Addr),
            .Data(logic[31:0])
        ) write_if();


        logic i_clk;
        logic i_rst;

        task next_cycle();
            #(HOLD);
            @(posedge i_clk);
            #(HOLD);
        endtask

        \{ ICacheSplitAccessWrapper \} icache(
            .i_clk,
            .i_rst,
            .fetch_if_valid (core_if.valid),
            .fetch_if_addr (core_if.addr),
            .fetch_if_ready (core_if.ready),
            .fetch_if_instr (core_if.instr),
            .core_write_if_wvalid (core_if.wvalid),
            .core_write_if_waddr (core_if.waddr),
            .core_write_if_wdata (core_if.wdata),
            .core_write_if_wstrb (core_if.wstrb),
            .core_write_if_wready (core_if.wready),
            .read_if_arvalid  (read_if.arvalid),
            .read_if_arready  (read_if.arready),
            .read_if_araddr   (read_if.araddr ),
            .read_if_arid    (read_if.arid   ),
            .read_if_arlen   (read_if.arlen  ),
            .read_if_arsize  (read_if.arsize ),
            .read_if_arburst (read_if.arburst),
            .read_if_rvalid  (read_if.rvalid ),
            .read_if_rready  (read_if.rready ),
            .read_if_rdata   (read_if.rdata  ),
            .read_if_rid     (read_if.rid    ),
            .read_if_rresp   (read_if.rresp  ),
            .read_if_rlast   (read_if.rlast  ),
            .write_if_awvalid(write_if.awvalid),
            .write_if_awready(write_if.awready),
            .write_if_awaddr (write_if.awaddr ),
            .write_if_awid   (write_if.awid   ),
            .write_if_awlen  (write_if.awlen  ),
            .write_if_awsize (write_if.awsize ),
            .write_if_awburst(write_if.awburst),
            .write_if_wvalid (write_if.wvalid ),
            .write_if_wready (write_if.wready ),
            .write_if_wdata  (write_if.wdata  ),
            .write_if_wstrb  (write_if.wstrb  ),
            .write_if_wlast  (write_if.wlast  ),
            .write_if_bvalid (write_if.bvalid ),
            .write_if_bready (write_if.bready ),
            .write_if_bid    (write_if.bid    ),
            .write_if_bresp  (write_if.bresp  )
        );
        \{ AxiRamWrapper \} axi_ram (
            .i_clk          (i_clk         ),
            .i_rst          (i_rst         ),
            .mem_read_if_arvalid  (read_if.arvalid),
            .mem_read_if_arready  (read_if.arready),
            .mem_read_if_araddr   (read_if.araddr ),
            .mem_read_if_arid    (read_if.arid   ),
            .mem_read_if_arlen   (read_if.arlen  ),
            .mem_read_if_arsize  (read_if.arsize ),
            .mem_read_if_arburst (read_if.arburst),
            .mem_read_if_rvalid  (read_if.rvalid ),
            .mem_read_if_rready  (read_if.rready ),
            .mem_read_if_rdata   (read_if.rdata  ),
            .mem_read_if_rid     (read_if.rid    ),
            .mem_read_if_rresp   (read_if.rresp  ),
            .mem_read_if_rlast   (read_if.rlast  ),
            .mem_write_if_awvalid(write_if.awvalid),
            .mem_write_if_awready(write_if.awready),
            .mem_write_if_awaddr (write_if.awaddr ),
            .mem_write_if_awid   (write_if.awid   ),
            .mem_write_if_awlen  (write_if.awlen  ),
            .mem_write_if_awsize (write_if.awsize ),
            .mem_write_if_awburst(write_if.awburst),
            .mem_write_if_wvalid (write_if.wvalid ),
            .mem_write_if_wready (write_if.wready ),
            .mem_write_if_wdata  (write_if.wdata  ),
            .mem_write_if_wstrb  (write_if.wstrb  ),
            .mem_write_if_wlast  (write_if.wlast  ),
            .mem_write_if_bvalid (write_if.bvalid ),
            .mem_write_if_bready (write_if.bready ),
            .mem_write_if_bid    (write_if.bid    ),
            .mem_write_if_bresp  (write_if.bresp  )
        );

        Id w_id;
        Resp w_resp;
        Addr w_addr;
        Burst w_burst;
        Size w_size;
        Len w_len;

        // TODO: miss/hit, cross boundary の全パターンを網羅したテストがあるとGood
        // | line 1 miss | line 1 cross boundary | line 2 hit | line 2 cross boundary |
        // +-------------+-----------------------+------------+-----------------------+
        // | miss | no | miss | no |
        // | miss | no | miss | yes |
        // | miss | no | hit | no |
        // | miss | no | hit | yes |
        // | miss | yes | miss | no |
        // | miss | yes | miss | yes |
        // | miss | yes | hit | no |
        // | miss | yes | hit | yes |
        // | hit | no | miss | no |
        // | hit | no | miss | yes |
        // | hit | no | hit | no |
        // | hit | no | hit | yes |
        // | hit | yes | miss | no |
        // | hit | yes | miss | yes |
        // | hit | yes | hit | no |
        // | hit | yes | hit | yes |

        initial begin
            $display("Starting test...");
            i_clk = 0;
            i_rst = 1;

            core_if.valid = 0;
            core_if.addr = '0;
            read_if.arready = 0;
            read_if.rvalid = 0;
            read_if.rdata = '0;
            read_if.rlast = '0;
            read_if.rresp = Resp_OKAY;
            read_if.rid = '0;
            for (int i = 0; i < LINE_SIZE_BYTES/4 * 2; i++) begin
                axi_ram.axi_ram.r_mem[i] = 32'hdeadbe00 + i;
            end

            repeat (2) next_cycle();
            $display("reset done");

            i_rst = 0;
            core_if.valid = 1;
            core_if.addr = '0; // miss アクセス
            next_cycle();
            core_if.addr = 4; // hit するアクセス
            while (!core_if.ready) next_cycle();
            assert(core_if.instr == {16'hbe00 + 16'h1, 32'hdeadbe00 + 32'h0}) else $error("Instruction0 mismatch!: %h", core_if.instr);
            next_cycle();

            core_if.addr = LINE_SIZE_BYTES - 4; // cross boundary なアクセス
            assert(core_if.ready) else $error("Instruction not valid!");
            assert(core_if.instr == {16'hbe00 + 16'h2, 32'hdeadbe00 + 32'h1}) else $error("Instruction1 mismatch!: %h", core_if.instr);
            next_cycle();

            // 1ライン目は hit
            next_cycle();
            // 2ライン目を返す
            while (!core_if.ready) next_cycle();
            assert(core_if.instr == {16'hbe00 + 16'h8, 32'hdeadbe00 + 32'h7}) else $error("Instruction2 mismatch!: %h", core_if.instr);

            next_cycle();
            $display("Test passed!");
            
            $finish;
        end

        always #STEP i_clk = ~i_clk;

        initial begin
            repeat(1000) @(posedge i_clk);
            $finish();
        end

    endmodule
}}}
