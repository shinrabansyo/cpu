#[test(dcache_tb)]
embed (inline) sv{{{
    module dcache_tb();
        import \{ Config \}::*;
        import \{ axi_pkg \}::*;

        localparam int HOLD = 5;
        localparam int STEP = 20;

        \{ core_dcache_if \} core_if();
        \{ axi_read_if \} #(
            .Addr(Addr),
            .Data(logic[31:0])
        ) mem_read_if();
        \{ axi_write_if \} #(
            .Addr(Addr),
            .Data(logic[31:0])
        ) mem_write_if();


        logic i_clk;
        logic i_rst;

        task next_cycle();
            #(HOLD);
            @(posedge i_clk);
            #(HOLD);
        endtask

        \{ DCacheSplitAccessWrapper \} dcache(
            .i_clk,
            .i_rst,
            .core_if_valid (core_if.valid),
            .core_if_addr (core_if.addr),
            .core_if_wen (core_if.wen),
            .core_if_wdata (core_if.wdata),
            .core_if_wstrb (core_if.wstrb),
            .core_if_rdata (core_if.rdata),
            .core_if_ready (core_if.ready),
            .mem_read_if_arvalid  (mem_read_if.arvalid),
            .mem_read_if_arready  (mem_read_if.arready),
            .mem_read_if_araddr   (mem_read_if.araddr ),
            .mem_read_if_arid    (mem_read_if.arid   ),
            .mem_read_if_arlen   (mem_read_if.arlen  ),
            .mem_read_if_arsize  (mem_read_if.arsize ),
            .mem_read_if_arburst (mem_read_if.arburst),
            .mem_read_if_rvalid  (mem_read_if.rvalid ),
            .mem_read_if_rready  (mem_read_if.rready ),
            .mem_read_if_rdata   (mem_read_if.rdata  ),
            .mem_read_if_rid     (mem_read_if.rid    ),
            .mem_read_if_rresp   (mem_read_if.rresp  ),
            .mem_read_if_rlast   (mem_read_if.rlast  ),
            .mem_write_if_awvalid (mem_write_if.awvalid),
            .mem_write_if_awready (mem_write_if.awready),
            .mem_write_if_awaddr  (mem_write_if.awaddr ),
            .mem_write_if_awid    (mem_write_if.awid   ),
            .mem_write_if_awlen   (mem_write_if.awlen  ),
            .mem_write_if_awsize  (mem_write_if.awsize ),
            .mem_write_if_awburst (mem_write_if.awburst),
            .mem_write_if_wvalid  (mem_write_if.wvalid ),
            .mem_write_if_wready  (mem_write_if.wready ),
            .mem_write_if_wid     (mem_write_if.wid    ),
            .mem_write_if_wdata   (mem_write_if.wdata  ),
            .mem_write_if_wstrb   (mem_write_if.wstrb  ),
            .mem_write_if_wlast   (mem_write_if.wlast  ),
            .mem_write_if_bvalid  (mem_write_if.bvalid ),
            .mem_write_if_bready  (mem_write_if.bready ),
            .mem_write_if_bid     (mem_write_if.bid    ),
            .mem_write_if_bresp   (mem_write_if.bresp  )
        );
        \{ AxiRamWrapper \} axi_ram (
            .i_clk          (i_clk         ),
            .i_rst          (i_rst         ),
            .mem_read_if_arvalid  (mem_read_if.arvalid),
            .mem_read_if_arready  (mem_read_if.arready),
            .mem_read_if_araddr   (mem_read_if.araddr ),
            .mem_read_if_arid    (mem_read_if.arid   ),
            .mem_read_if_arlen   (mem_read_if.arlen  ),
            .mem_read_if_arsize  (mem_read_if.arsize ),
            .mem_read_if_arburst (mem_read_if.arburst),
            .mem_read_if_rvalid  (mem_read_if.rvalid ),
            .mem_read_if_rready  (mem_read_if.rready ),
            .mem_read_if_rdata   (mem_read_if.rdata  ),
            .mem_read_if_rid     (mem_read_if.rid    ),
            .mem_read_if_rresp   (mem_read_if.rresp  ),
            .mem_read_if_rlast   (mem_read_if.rlast  ),
            .mem_write_if_awvalid(mem_write_if.awvalid),
            .mem_write_if_awready(mem_write_if.awready),
            .mem_write_if_awaddr (mem_write_if.awaddr ),
            .mem_write_if_awid   (mem_write_if.awid   ),
            .mem_write_if_awlen  (mem_write_if.awlen  ),
            .mem_write_if_awsize (mem_write_if.awsize ),
            .mem_write_if_awburst(mem_write_if.awburst),
            .mem_write_if_wvalid (mem_write_if.wvalid ),
            .mem_write_if_wready (mem_write_if.wready ),
            .mem_write_if_wdata  (mem_write_if.wdata  ),
            .mem_write_if_wstrb  (mem_write_if.wstrb  ),
            .mem_write_if_wlast  (mem_write_if.wlast  ),
            .mem_write_if_bvalid (mem_write_if.bvalid ),
            .mem_write_if_bready (mem_write_if.bready ),
            .mem_write_if_bid    (mem_write_if.bid    ),
            .mem_write_if_bresp  (mem_write_if.bresp  )
        );

        Id w_id;
        Resp w_resp;
        Addr w_addr;
        Burst w_burst;
        Size w_size;
        Len w_len;

        // TODO: miss/hit, cross boundary の全パターンを網羅したテストがあるとGood
        // | line 1 miss | line 1 cross boundary | line 2 hit | line 2 cross boundary |
        // +-------------+-----------------------+------------+-----------------------+
        // | miss | no | miss | no |
        // | miss | no | miss | yes |
        // | miss | no | hit | no |
        // | miss | no | hit | yes |
        // | miss | yes | miss | no |
        // | miss | yes | miss | yes |
        // | miss | yes | hit | no |
        // | miss | yes | hit | yes |
        // | hit | no | miss | no |
        // | hit | no | miss | yes |
        // | hit | no | hit | no |
        // | hit | no | hit | yes |
        // | hit | yes | miss | no |
        // | hit | yes | miss | yes |
        // | hit | yes | hit | no |
        // | hit | yes | hit | yes |

        initial begin
            $display("Starting test...");
            i_clk = 0;
            i_rst = 1;

            core_if.valid = 0;
            core_if.addr = '0;
            for (int i = 0; i < LINE_SIZE_BYTES/4 * 2; i++) begin
                axi_ram.axi_ram.r_mem[i] = 32'hdeadbe00 + i;
            end

            repeat (2) next_cycle();
            $display("reset done");
            
            // read テスト
            i_rst = 0;
            core_if.valid = 1;
            core_if.addr = '0; // miss アクセス
            next_cycle();
            core_if.valid = 0;
            while (!core_if.ready) next_cycle();
            assert(core_if.rdata == 32'hdeadbe00) else $error("data0 mismatch!: %h != %h", 32'hdeadbe00, core_if.rdata);

            core_if.valid = 1;
            core_if.addr = LINE_SIZE_BYTES - 2; // cross boundary なアクセス
            next_cycle();
            core_if.valid = 0;
            while (!core_if.ready) next_cycle();
            assert(core_if.ready) else $error("rdata not valid!");
            assert(core_if.rdata == 32'hbe08dead) else $error("data1 mismatch!: %h != %h", 32'hbe08dead, core_if.rdata);
            next_cycle();

            // TODO: Write テスト
            // ミスリクエスト / 4byte 書き込み
            core_if.valid = 1;
            core_if.wen = 1;
            core_if.wstrb = 4'b1111;
            core_if.wdata = 32'hcafebabe;
            core_if.addr = 64;
            next_cycle();
            core_if.valid = 0;
            while (!core_if.ready) next_cycle();
            // 書き込み完了後、同じアドレスをリード
            core_if.valid = 1;
            core_if.wen = 0;
            next_cycle();
            core_if.valid = 0;
            while (!core_if.ready) next_cycle();
            assert(core_if.rdata == 32'hcafebabe) else $error("write data0 mismatch!: %h != %h", 32'hcafebabe, core_if.rdata);

            // ヒット / 2byte 書き込み
            core_if.valid = 1;
            core_if.wen = 1;
            core_if.wstrb = 4'b0011;
            core_if.wdata = 32'h0000beef;
            core_if.addr = 64;
            next_cycle();
            core_if.valid = 0;
            while (!core_if.ready) next_cycle();
            // 書き込み完了後、同じアドレスをリード
            core_if.valid = 1;
            core_if.wen = 0;
            next_cycle();
            core_if.valid = 0;
            while (!core_if.ready) next_cycle();
            assert(core_if.rdata == 32'hcafebeef) else $error("write data1 mismatch!: %h != %h", 32'hcafebeef, core_if.rdata);

            // ライン跨ぎ書き込み
            core_if.valid = 1;
            core_if.wen = 1;
            core_if.wstrb = 4'b1111;
            core_if.wdata = 32'h76543210;
            core_if.addr = 32*3 - 2;
            next_cycle();
            core_if.valid = 0;
            while (!core_if.ready) next_cycle();
            core_if.valid = 1;
            core_if.wen = 0;
            next_cycle();
            core_if.valid = 0;
            while (!core_if.ready) next_cycle();
            assert(core_if.rdata == 32'h76543210) else $error("write data2 mismatch!: %h != %h", 32'h76543210, core_if.rdata);

            next_cycle();
            next_cycle();
            next_cycle();

            $display("Test passed!");
            
            $finish;
        end

        always #STEP i_clk = ~i_clk;

        initial begin
            repeat(1000) @(posedge i_clk);
            $error("Test Timeout!");
            $finish();
        end

    endmodule
}}}
