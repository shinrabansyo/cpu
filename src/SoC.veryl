module SoC (
    // クロック・リセット
    i_clk: input clock,
    i_rst: input reset,

    // UART
    o_tx: output logic<1>,
    i_rx: input  logic<1>,

    // SPI
    o_sclk: output logic<1>,
    o_mosi: output logic<1>,
    i_miso: input  logic<1>,

    // GPIO
    o_gpout: output logic<8>,

    // HDMI
    i_clk_dvi: input  'dvi clock    ,
    i_rst_dvi: input  'dvi reset    ,
    o_vsync  : output 'dvi logic<1> ,
    o_hsync  : output 'dvi logic<1> ,
    o_de     : output 'dvi logic<1> ,
    o_data   : output 'dvi logic<24>,
) {
    inst core: Core (
        i_clk          ,
        i_rst          ,
        imem_read_if   ,
        dmem_read_if   ,
        dmem_write_if  ,
        o_tx           ,
        i_rx           ,
        o_sclk         ,
        o_mosi         ,
        i_miso         ,
        o_gpout        ,
        i_clk_dvi      ,
        i_rst_dvi      ,
        o_vsync        ,
        o_hsync        ,
        o_de           ,
        o_data         ,
    );

    // TODO: 命令メモリ用の AXI インターコネクトを作る
    inst imem_read_if : axi_read_if;
    inst imem_write_if: axi_write_if;
    inst dmem_read_if : axi_read_if;
    inst dmem_write_if: axi_write_if;

    inst imem_read_if_slaves : axi_read_if [2];
    inst imem_write_if_slaves: axi_write_if [2];

    // [ROM, RAM]
    const imem_map_base: logic<32> [2] = '{32'h0000_0000, 32'h8000_0000};
    const imem_map_size: logic<32> [2] = '{32'h0001_0000, 32'h0001_0000};

    inst imem_interconnect: axi_interconnect #(
        NUM_SLAVE   : 2            ,
        MEM_MAP_BASE: imem_map_base,
        MEM_MAP_SIZE: imem_map_size,
    ) (
        i_clk                                ,
        i_rst                                ,
        read_if_master : imem_read_if        ,
        write_if_master: imem_write_if       ,
        read_if_slaves : imem_read_if_slaves ,
        write_if_slaves: imem_write_if_slaves,
    );
    always_comb {
        imem_write_if.awvalid = 0;
        imem_write_if.awaddr  = 0;
        imem_write_if.awid    = 0;
        imem_write_if.awlen   = 0;
        imem_write_if.awsize  = 0;
        imem_write_if.awburst = 0 as axi_pkg::Burst;
        imem_write_if.wvalid  = 0;
        imem_write_if.wdata   = 0;
        imem_write_if.wstrb   = 0;
        imem_write_if.wlast   = 0;
        imem_write_if.bready  = 0;
    }

    inst m_axi_irom: AxiRom (
        i_clk  : i_clk                 ,
        i_rst  : i_rst                 ,
        read_if: imem_read_if_slaves[0],
    );
    inst m_axi_iram: AxiRam (
        i_clk   : i_clk                  ,
        i_rst   : i_rst                  ,
        read_if : imem_read_if_slaves[1] ,
        write_if: imem_write_if_slaves[1],
    );
    inst m_axi_dram: AxiRam (
        i_clk                  ,
        i_rst                  ,
        read_if : dmem_read_if ,
        write_if: dmem_write_if,
    );
}
