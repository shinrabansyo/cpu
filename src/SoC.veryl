module SoC (
    // クロック・リセット
    i_clk: input clock,
    i_rst: input reset,

    // UART
    o_tx: output logic<1>,
    i_rx: input  logic<1>,

    // SPI
    o_sclk: output logic<1>,
    o_mosi: output logic<1>,
    i_miso: input  logic<1>,

    // GPIO
    o_gpout: output logic<8>,

    // HDMI
    i_clk_dvi: input  'dvi clock    ,
    i_rst_dvi: input  'dvi reset    ,
    o_vsync  : output 'dvi logic<1> ,
    o_hsync  : output 'dvi logic<1> ,
    o_de     : output 'dvi logic<1> ,
    o_data   : output 'dvi logic<24>,
) {
    inst core: Core #()(
        i_clk,
        i_rst,
        imem_read_if,
        o_tx,
        i_rx,
        o_sclk,
        o_mosi,
        i_miso,
        o_gpout,
        i_clk_dvi,
        i_rst_dvi,
        o_vsync,
        o_hsync,
        o_de,
        o_data,
    );

    // TODO: 命令メモリ用の AXI インターコネクトを作る
    inst imem_read_if: axi_read_if();

    inst m_axi_ram: AxiRam (
        i_clk         : i_clk               ,
        i_rst         : i_rst               ,
        mem_read_if_arvalid: imem_read_if.arvalid,
        mem_read_if_arready: imem_read_if.arready,
        mem_read_if_araddr : imem_read_if.araddr ,
        mem_read_if_arid   : imem_read_if.arid   ,
        mem_read_if_arlen  : imem_read_if.arlen  ,
        mem_read_if_arsize : imem_read_if.arsize ,
        mem_read_if_arburst: imem_read_if.arburst,
        mem_read_if_rvalid : imem_read_if.rvalid ,
        mem_read_if_rready : imem_read_if.rready ,
        mem_read_if_rdata  : imem_read_if.rdata  ,
        mem_read_if_rid    : imem_read_if.rid    ,
        mem_read_if_rresp  : imem_read_if.rresp  ,
        mem_read_if_rlast  : imem_read_if.rlast  ,

        mem_write_if_awvalid: 0,
        mem_write_if_awready: _,
        mem_write_if_awaddr : 0,
        mem_write_if_awid   : 0,
        mem_write_if_awlen  : 0,
        mem_write_if_awsize : 0,
        mem_write_if_awburst: 0,
        mem_write_if_wvalid : 0,
        mem_write_if_wready : _,
        mem_write_if_wdata  : 0,
        mem_write_if_wstrb  : 0,
        mem_write_if_wlast  : 0,
    );
}
