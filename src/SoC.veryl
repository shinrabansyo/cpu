module SoC #(
    param PIPELINE: u32 = 1,
) (
    // クロック・リセット
    i_clk: input clock,
    i_rst: input reset,

    // UART
    o_tx: output logic<1>,
    i_rx: input  logic<1>,

    // SPI
    o_sclk: output logic<1>,
    o_mosi: output logic<1>,
    i_miso: input  logic<1>,

    // GPIO
    o_gpout: output logic<8>,

    // HDMI
    i_clk_dvi: input  'dvi clock    ,
    i_rst_dvi: input  'dvi reset    ,
    o_vsync  : output 'dvi logic<1> ,
    o_hsync  : output 'dvi logic<1> ,
    o_de     : output 'dvi logic<1> ,
    o_data   : output 'dvi logic<24>,
) {
    import Config::*;
    inst if_io_bus_din : Decoupled #( Width: 32 );
    inst if_io_bus_dout: Decoupled #( Width: 32 );
    var w_dev_id      : Addr;

    if PIPELINE == 0 :l_no_pipeline {
        inst core: Core (
            i_clk                   ,
            i_rst                   ,
            imem_read_if            ,
            imem_write_if           ,
            dmem_read_if            ,
            dmem_write_if           ,
            o_dev_id      : w_dev_id,
            if_io_bus_din           ,
            if_io_bus_dout          ,
        );
    } else {
        inst core: PipelineCore (
            i_clk                   ,
            i_rst                   ,
            imem_read_if            ,
            imem_write_if           ,
            dmem_read_if            ,
            dmem_write_if           ,
            o_dev_id      : w_dev_id,
            if_io_bus_din           ,
            if_io_bus_dout          ,
        );
    }

    // TODO: 命令メモリ用の AXI インターコネクトを作る
    inst imem_read_if : axi_read_if #( Addr, Data );
    inst imem_write_if: axi_write_if #( Addr, Data );
    inst dmem_read_if : axi_read_if #( Addr, Data );
    inst dmem_write_if: axi_write_if #( Addr, Data );

    inst imem_read_if_slaves : axi_read_if [2] #( Addr, Data );
    inst imem_write_if_slaves: axi_write_if [2] #( Addr, Data );

    // [ROM, RAM]
    const imem_map_base: logic<32> [2] = '{32'h0000_0000, 32'h0000_1000};
    const imem_map_size: logic<32> [2] = '{32'h0000_1000, 32'h0001_0000};

    inst imem_interconnect: axi_interconnect #(
        NUM_SLAVE   : 2            ,
        MEM_MAP_BASE: imem_map_base,
        MEM_MAP_SIZE: imem_map_size,
    ) (
        i_clk                                ,
        i_rst                                ,
        read_if_master : imem_read_if        ,
        write_if_master: imem_write_if       ,
        read_if_slaves : imem_read_if_slaves ,
        write_if_slaves: imem_write_if_slaves,
    );
    always_comb {
        imem_write_if_slaves[0].awready = 1;
        imem_write_if_slaves[0].wready  = 1;
        imem_write_if_slaves[0].bvalid  = 1;
        imem_write_if_slaves[0].bid     = 0;
        imem_write_if_slaves[0].bresp   = axi_pkg::Resp::SLVERR; // ROM への書き込みはエラー
    }

    inst m_axi_irom: AxiRom (
        i_clk  : i_clk                 ,
        i_rst  : i_rst                 ,
        read_if: imem_read_if_slaves[0],
    );
    inst m_axi_iram: AxiRam (
        i_clk   : i_clk                  ,
        i_rst   : i_rst                  ,
        read_if : imem_read_if_slaves[1] ,
        write_if: imem_write_if_slaves[1],
    );
    inst m_axi_dram: AxiRam (
        i_clk                  ,
        i_rst                  ,
        read_if : dmem_read_if ,
        write_if: dmem_write_if,
    );

    // IOBus
    inst io_bus: IOBus #(
        ClockFrequency: 12_000_000,
        UartBaudRate  : 115200    ,
    ) (
        i_clk                    ,
        i_rst                    ,
        i_dev_id : w_dev_id      ,
        if_din   : if_io_bus_dout,
        if_dout  : if_io_bus_din ,
        o_tx                     ,
        i_rx                     ,
        o_sclk                   ,
        o_mosi                   ,
        i_miso                   ,
        o_gpout                  ,
        i_clk_dvi                ,
        i_rst_dvi                ,
        o_vsync                  ,
        o_hsync                  ,
        o_de                     ,
        o_data                   ,
    );
}
