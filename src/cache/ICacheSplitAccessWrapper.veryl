module ICacheSplitAccessWrapper (
    i_clk: input clock,
    i_rst: input reset,

    // read request
    fetch_if_valid: input  logic,
    fetch_if_addr : input  Addr ,
    fetch_if_ready: output logic,
    fetch_if_instr: output Inst ,
    // write request
    core_write_if_wvalid: input  logic                 ,
    core_write_if_waddr : input  Addr                  ,
    core_write_if_wdata : input  Data                  ,
    core_write_if_wstrb : input  logic<$bits(Data) / 8>,
    core_write_if_wready: output logic                 ,

    // memory interface
    read_if_arvalid: output logic,
    read_if_arready: input  logic,
    read_if_araddr : output Addr ,
    read_if_arid   : output Id   ,
    read_if_arlen  : output Len  ,
    read_if_arsize : output Size ,
    read_if_arburst: output Burst,

    read_if_rvalid: input  logic    ,
    read_if_rready: output logic    ,
    read_if_rdata : input  logic<32>,
    read_if_rid   : input  Id       ,
    read_if_rresp : input  Resp     ,
    read_if_rlast : input  logic    ,

    write_if_awvalid: output logic,
    write_if_awready: input  logic,
    write_if_awaddr : output Addr ,
    write_if_awid   : output Id   ,
    write_if_awlen  : output Len  ,
    write_if_awsize : output Size ,
    write_if_awburst: output Burst,
    write_if_wvalid : output logic    ,
    write_if_wready : input  logic    ,
    write_if_wdata  : output logic<32>,
    write_if_wstrb  : output logic<32 / 8>,
    write_if_wlast  : output logic    ,
    write_if_bvalid : input  logic    ,
    write_if_bready : output logic    ,
    write_if_bid    : input  Id       ,
    write_if_bresp  : input  Resp     ,
) {
    import Config::*;
    import axi_pkg::*;

    inst core_if: core_icache_if;
    inst read_if : axi_read_if;
    inst write_if: axi_write_if;

    always_comb {
        core_if.valid = fetch_if_valid;
        core_if.addr  = fetch_if_addr;
        fetch_if_instr = core_if.instr;
        fetch_if_ready = core_if.ready;

        core_if.wvalid = core_write_if_wvalid;
        core_if.waddr = core_write_if_waddr;
        core_if.wdata = core_write_if_wdata;
        core_if.wstrb = core_write_if_wstrb;
        core_write_if_wready = core_if.wready;

        read_if.arready = read_if_arready;
        read_if_arvalid = read_if.arvalid;
        read_if_araddr  = read_if.araddr;
        read_if_arid    = read_if.arid;
        read_if_arlen   = read_if.arlen;
        read_if_arsize  = read_if.arsize;
        read_if_arburst = read_if.arburst;

        read_if.rvalid = read_if_rvalid;
        read_if_rready = read_if.rready;
        read_if.rdata  = read_if_rdata;
        read_if.rid    = read_if_rid;
        read_if.rresp  = read_if_rresp;
        read_if.rlast  = read_if_rlast;

        write_if_awvalid = write_if.awvalid;
        write_if.awready = write_if_awready;
        write_if_awaddr  = write_if.awaddr;
        write_if_awid    = write_if.awid;
        write_if_awlen   = write_if.awlen;
        write_if_awsize  = write_if.awsize;
        write_if_awburst = write_if.awburst;
        write_if_wvalid  = write_if.wvalid;
        write_if.wready  = write_if_wready;
        write_if_wdata   = write_if.wdata;
        write_if_wstrb   = write_if.wstrb;
        write_if_wlast   = write_if.wlast;

        write_if.bvalid  = write_if_bvalid;
        write_if_bready  = write_if.bready;
        write_if.bid     = write_if_bid;
        write_if.bresp   = write_if_bresp;
    }

    inst icache_split_access: ICacheSplitAccess (
        i_clk: i_clk,
        i_rst: i_rst,

        fetch_if: core_if,
        core_write_if: core_if,

        read_if,
        write_if,
    );

}
