/// 2ラインの境界をまたがるアクセスに非対応のキャッシュ
/// ヒット時のレイテンシ 1 サイクル
pub module ICacheNonSplitAccess (
    i_clk: input clock,
    i_rst: input reset,

    // read request
    core_if: modport core_icache_if::icache,

    // memory interface
    mem_if: modport axi_read_if::master,
) {
    import Config::*;

    enum State {
        IDLE,
        FETCH,
        READ,
    }

    type Data = logic<32>;

    // メモリに対して 32bit ずつ、 $bits(Line)/32bit 回アクセスしてラインを取得する。
    const BEAT_MAX          : u32 = $bits(Line) / $bits(Data);
    const BEAT_COUNTER_WIDTH: u32 = $clog2(BEAT_MAX);

    var r_valid       : logic                    ;
    var r_addr        : Addr                     ;
    var r_state       : State                    ;
    var r_beat_counter: logic<BEAT_COUNTER_WIDTH>;
    var w_miss        : logic                    ;
    var w_stall       : logic                    ;

    var w_ta_set   : ICacheSet;
    var w_ta_tag   : ICacheTag;
    var w_ta_we    : logic    ;
    var w_ta_wvalid: logic    ;
    var w_ta_hit   : logic    ;

    var w_da_set        : ICacheSet    ;
    var w_da_line_offset: LineOffset   ;
    var w_da_we         : logic        ;
    var w_da_wmask      : logic     <8>;
    var w_da_wdata      : DoubleData   ;
    var w_da_rdata      : DoubleData   ;

    inst tag_array: TagArray (
        i_clk: i_clk,
        i_rst: i_rst,

        i_set   : w_ta_set   ,
        i_tag   : w_ta_tag   ,
        i_we    : w_ta_we    ,
        i_wvalid: w_ta_wvalid, // キャッシュの flush 時はこのポートを使って invalidate する
        o_hit   : w_ta_hit   ,
    );
    // SET_WIDTH は default param で指定しているが、
    // 明示的に指定しないと verilator のバグを踏み抜く
    inst data_array: DataArray #(
        SET_WIDTH: $bits(ICacheSet),
    ) (
        i_clk: i_clk,
        i_rst: i_rst,

        i_set        : w_da_set        ,
        i_line_offset: w_da_line_offset,
        i_we         : w_da_we         ,
        i_wmask      : w_da_wmask      ,
        i_wdata      : w_da_wdata      ,
        o_rdata      : w_da_rdata      ,
    );

    always_comb {
        w_miss  = r_valid && !w_ta_hit;
        w_stall = w_miss | r_state != State::IDLE;

        core_if.ready = !w_stall && r_valid;
        core_if.instr = w_da_rdata[0+:48];

        w_ta_set         = GetICacheSet(core_if.addr);
        w_ta_tag         = GetICacheTag(core_if.addr);
        w_ta_we          = 0;
        w_ta_wvalid      = 0;
        w_da_set         = GetICacheSet(core_if.addr);
        w_da_line_offset = GetLineOffset(core_if.addr);
        w_da_we          = 0;
        w_da_wmask       = 0;
        w_da_wdata       = '0;
        case (r_state) {
            State::FETCH: {
                if mem_if.rvalid && mem_if.rready {
                    w_da_set         = GetICacheSet(GetLineAddr(r_addr));
                    w_da_line_offset = r_beat_counter << 2;
                    w_da_we          = 1;
                    w_da_wmask       = 8'b1111;
                    w_da_wdata       = mem_if.rdata as DoubleData;
                    if mem_if.rlast {
                        w_ta_set    = GetICacheSet(GetLineAddr(r_addr));
                        w_ta_tag    = GetICacheTag(GetLineAddr(r_addr));
                        w_ta_we     = 1;
                        w_ta_wvalid = 1;
                    }
                }
            }
            State::READ: {
                w_ta_set         = GetICacheSet(r_addr);
                w_ta_tag         = GetICacheTag(r_addr);
                w_da_set         = GetICacheSet(r_addr);
                w_da_line_offset = GetLineOffset(r_addr);
            }
        }
    }

    always_ff (i_clk, i_rst) {
        if_reset {
            r_addr         = '0;
            r_valid        = 0;
            r_state        = State::IDLE;
            r_beat_counter = '0;
            mem_if.arvalid = 0;
            mem_if.araddr  = '0;
            mem_if.arid    = 0;
            mem_if.arsize  = 2;
            // mem_if.arlen   = (BEAT_MAX - 1) as axi_pkg::Len;
            mem_if.arlen   = '0;
            mem_if.arburst = axi_pkg::Burst::INCR;
            mem_if.rready  = 0;
        } else {
            if !w_stall {
                r_addr  = core_if.addr;
                r_valid = core_if.valid;
            }
            case (r_state) {
                State::IDLE: {
                    if w_miss {
                        r_state = State::FETCH;

                        mem_if.arvalid = 1;
                        mem_if.araddr  = GetLineAddr(r_addr);
                        mem_if.arsize  = 2;
                        mem_if.arlen   = (BEAT_MAX - 1) as axi_pkg::Len;
                        mem_if.arburst = axi_pkg::Burst::INCR;
                        mem_if.rready  = 1;
                        r_beat_counter = '0;
                    }
                }
                State::FETCH: {
                    if mem_if.arvalid && mem_if.arready {
                        mem_if.arvalid = 0;
                    }
                    if mem_if.rvalid && mem_if.rready {
                        r_beat_counter += 1;
                    }
                    if mem_if.rlast {
                        mem_if.rready = 0;
                        r_state       = State::READ;
                    }
                }
                State::READ: {
                    r_state = State::IDLE;
                }
            }
        }
    }
}
