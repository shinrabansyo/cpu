module DataArray (
    i_clk: input clock,
    i_rst: input reset,

    i_set_index: input  ICacheSet,
    i_we       : input  logic    ,
    i_line     : input  Line     ,
    o_line     : output Line     ,
) {
    import Config::*;

    inst mem: Ram #(
        DataType: Line     ,
        AddrType: ICacheSet,
    ) (
        i_clk: i_clk,
        i_rst: i_rst,

        i_addr: i_set_index,
        i_we  : i_we       ,
        i_data: i_line     ,
        o_data: o_line     ,
    );
}
