module PipelineCore (
    // クロック・リセット
    i_clk: input clock,
    i_rst: input reset,

    // Instruction Memory
    imem_read_if : modport axi_read_if::master ,
    imem_write_if: modport axi_write_if::master,

    // Data Memory
    dmem_read_if : modport axi_read_if::master ,
    dmem_write_if: modport axi_write_if::master,

    o_dev_id: output Addr,
    if_io_bus_din : modport Decoupled::sender  ,
    if_io_bus_dout: modport Decoupled::receiver,
) {
    import Config::*;
    import PipelinePkg::*;

    var r_regfile: Data [32];

    // fetch stage
    inst icache_if: core_icache_if;
    // fetch stage output
    var w_fd_instr_valid: logic;
    var w_fd_pc         : Addr ;
    var w_fd_instr      : Inst ;

    // decode stage
    var w_d_log: log_pkg::InstLog;
    var w_d_branch_instr  : logic                  ;
    var w_d_branch_type: BranchType                  ;
    var w_d_rs1        : logic <5>              ;
    var w_d_rs2        : logic <5>              ;
    var w_d_imm        : Data                   ;
    var w_d_src2_reg   : logic                  ;
    var w_d_alu_cmd    : AluCmd                 ;
    var w_d_load_instr : logic;
    var w_d_dmem_access: logic                  ;
    var w_d_dmem_wen   : logic                  ;
    var w_d_imem_wen   : logic                  ;
    var w_d_mem_wstrb  : logic <$bits(Data) / 8>;
    var w_d_io_access  : logic                  ;
    var w_d_io_wen     : logic                  ;
    var w_d_rd         : logic <5>              ;
    var w_d_reg_wen    : logic                  ;
    var w_d_load_en    : logic                  ;
    var w_d_load_width : logic <2>              ;
    var w_d_load_sext  : logic                  ;
    var w_d_wb_type : WbType;
    // decode stage output
    var r_de_log: log_pkg::InstLog;
    var r_de_branch_instr  : logic                  ;
    var r_de_branch_type: BranchType                  ;
    var r_de_instr_valid: logic                  ;
    var r_de_pc         : Addr                   ;
    var r_de_instr      : Inst                   ;
    var r_de_rs1    : logic<5>                   ;
    var r_de_rs2    : logic<5>                   ;
    var r_de_reg_rs1    : Data                   ;
    var r_de_reg_rs2    : Data                   ;
    var r_de_imm        : Data                   ;
    var r_de_src2_reg   : logic                  ;
    var r_de_alu_cmd    : AluCmd                 ;
    var r_de_load_instr : logic;
    var r_de_dmem_access: logic                  ;
    var r_de_dmem_wen   : logic                  ;
    var r_de_imem_wen   : logic                  ;
    var r_de_mem_wstrb  : logic <$bits(Data) / 8>;
    var r_de_io_access  : logic                  ;
    var r_de_io_wen     : logic                  ;
    var r_de_rd         : logic <5>              ;
    var r_de_reg_wen    : logic                  ;
    var r_de_load_en    : logic                  ;
    var r_de_load_width : logic <2>              ;
    var r_de_load_sext  : logic                  ;
    var r_de_wb_type : WbType;

    // execute stage
    var w_ef_pc_target: Addr;
    var _w_ef_branch_taken: logic; // for branch prediction
    var w_e_alu_out : Data ;
    var w_e_alu_zero: logic;
    // execute stage output
    var r_em_log: log_pkg::InstLog;
    var r_em_instr_valid: logic                 ;
    var r_em_pc         : Addr                  ;
    var r_em_instr      : Inst                  ;
    var r_em_alu_out    : Data                  ;
    var r_em_alu_zero   : logic                 ;
    var r_em_dmem_access: logic                 ;
    var r_em_dmem_wen   : logic                 ;
    var r_em_imem_wen   : logic                 ;
    var r_em_mem_wstrb  : logic<$bits(Data) / 8>;
    var r_em_io_access  : logic                 ;
    var r_em_io_wen     : logic                 ;
    var r_em_reg_rs2    : Data                  ;
    var r_em_rs2:logic<5>;
    var r_em_rd         : logic<5>              ;
    var r_em_reg_wen    : logic                 ;
    var r_em_load_en    : logic                 ;
    var r_em_load_width : logic<2>              ;
    var r_em_load_sext  : logic                 ;
    var r_em_load_instr : logic;
    var r_em_wb_type : WbType;

    // memory access stage
    inst dcache_if: core_dcache_if;
    // memory access stage output
    var r_mw_log: log_pkg::InstLog;
    var r_mw_instr_valid: logic   ;
    var r_mw_pc         : Addr    ;
    var r_mw_instr      : Inst    ;
    var w_mw_read_data  : Data    ;
    var r_mw_alu_out    : Data    ;
    var r_mw_rd         : logic<5>;
    var r_mw_reg_wen    : logic   ;
    var r_mw_load_en    : logic   ;
    var r_mw_load_width : logic<2>;
    var r_mw_load_sext  : logic   ;
    var r_mw_load_instr : logic;
    var r_mw_wb_type : WbType;

    // writeback stage
    var w_w_log: log_pkg::InstLog;
    var w_w_reg_wdata: Data;

    // controll
    var w_f_branch_miss: logic;
    var w_wd_rs1_forward: logic;
    var w_wd_rs2_forward: logic;
    var w_me_rs1_forward: logic;
    var w_me_rs2_forward: logic;
    var w_we_rs1_forward: logic;
    var w_we_rs2_forward: logic;
    var w_wm_rs2_forward: logic;
    var w_f_stall: logic;
    var w_d_stall: logic;
    var w_e_stall: logic;
    var w_m_stall: logic;
    var w_fd_flush: logic;
    var w_de_flush: logic;
    var w_em_flush: logic;
    var w_mw_flush: logic;

    // Controller
    inst controller: Controller (
        // fetch stage
        o_branch_miss: w_f_branch_miss,

        // decode stage
        i_d_pc: w_fd_pc,
        i_d_rs1: w_d_rs1,
        i_d_rs2: w_d_rs2,
        o_wd_rs1_forward: w_wd_rs1_forward,
        o_wd_rs2_forward: w_wd_rs2_forward,

        // execute stage
        i_branch_instr: r_de_branch_instr,
        i_pc_target: w_ef_pc_target,
        i_e_rs1: r_de_rs1,
        i_e_rs2: r_de_rs2,
        i_e_rd: r_de_rd,
        i_e_load_instr: r_de_load_instr,
        o_me_rs1_forward: w_me_rs1_forward,
        o_me_rs2_forward: w_me_rs2_forward,
        o_we_rs1_forward: w_we_rs1_forward,
        o_we_rs2_forward: w_we_rs2_forward,

        // mem access stage
        i_m_rs2: r_em_rs2,
        i_m_rd: r_em_rd,
        i_m_instr_valid: r_em_instr_valid,
        o_wm_rs2_forward: w_wm_rs2_forward,

        // memory
        i_m_dmem_access: r_em_dmem_access,
        i_m_dmem_wen   : r_em_dmem_wen   ,
        i_dmem_ready : dcache_if.ready ,
        i_m_imem_wen   : r_em_imem_wen   ,
        i_imem_ready : icache_if.wready,
        // device
        i_m_io_access    : r_em_io_access      ,
        i_m_io_wen       : r_em_io_wen         ,
        i_io_din_valid : if_io_bus_din.valid ,
        i_io_dout_ready: if_io_bus_dout.ready,

        // writeback
        i_dmem_rdata_valid : dcache_if.rdata_valid,
        i_w_load_instr : r_mw_load_instr,
        i_w_rd: r_mw_rd,

        o_fd_flush: w_fd_flush,
        o_de_flush: w_de_flush,
        o_em_flush: w_em_flush,
        o_mw_flush: w_mw_flush,
        o_f_stall: w_f_stall,
        o_d_stall: w_d_stall,
        o_e_stall: w_e_stall,
        o_m_stall: w_m_stall,
    );

    // Fetch Stage -------------------
    inst icache: ICacheSplitAccess (
        i_clk,
        i_rst,
        fetch_if: icache_if,
        core_write_if: icache_if,
        read_if: imem_read_if,
        write_if: imem_write_if,
    );
    inst fetch_stage: Fetch (
        i_clk                          ,
        i_rst                          ,
        fetch_if     : icache_if       ,
        o_instr_valid: w_fd_instr_valid,
        o_pc         : w_fd_pc         ,
        o_instr      : w_fd_instr      ,
        i_pc_target : w_ef_pc_target,
        i_branch_miss: w_f_branch_miss,
        i_f_stall   : w_f_stall      ,
        i_fd_flush   : w_fd_flush      ,
    );

    // Decode Stage ------------------
    inst decode_stage: Decode (
        i_clk  ,
        i_rst  ,
        // log
        o_log : w_d_log,

        // fetch stage
        i_instr_valid: w_fd_instr_valid,
        i_pc         : w_fd_pc         ,
        i_instr      : w_fd_instr      ,

        o_branch_type: w_d_branch_type,
        o_branch_instr: w_d_branch_instr,

        // execute stage
        o_rs1     : w_d_rs1     ,
        o_rs2     : w_d_rs2     ,
        o_imm     : w_d_imm     ,
        o_src2_reg: w_d_src2_reg,
        o_alu_cmd : w_d_alu_cmd ,
        o_load_instr: w_d_load_instr,

        // mem access
        o_dmem_access: w_d_dmem_access,
        o_dmem_wen   : w_d_dmem_wen   ,
        o_imem_wen   : w_d_imem_wen   ,
        o_mem_wstrb  : w_d_mem_wstrb  ,

        // dev access
        o_io_access: w_d_io_access,
        o_io_wen   : w_d_io_wen   ,

        // writeback
        o_rd        : w_d_rd        ,
        o_reg_wen   : w_d_reg_wen   ,
        o_load_en   : w_d_load_en   ,
        o_load_width: w_d_load_width,
        o_load_sext : w_d_load_sext ,
        o_wb_type: w_d_wb_type,
    );
    always_ff (i_clk, i_rst) {
        if_reset {
            r_de_log = '0;
            r_de_branch_instr = 0;
            r_de_branch_type = 0 as BranchType;
            r_de_instr_valid = 0;
            r_de_pc          = 0;
            r_de_instr       = 0;
            r_de_rs1 = 0;
            r_de_rs2 = 0;
            r_de_reg_rs1     = 0;
            r_de_reg_rs2     = 0;
            r_de_imm         = 0;
            r_de_src2_reg    = 0;
            r_de_alu_cmd     = 0 as AluCmd;
            r_de_load_instr = 0;
            r_de_dmem_access = 0;
            r_de_dmem_wen    = 0;
            r_de_imem_wen    = 0;
            r_de_mem_wstrb   = 0;
            r_de_io_access   = 0;
            r_de_io_wen      = 0;
            r_de_rd          = 0;
            r_de_reg_wen     = 0;
            r_de_load_en     = 0;
            r_de_load_width  = 0;
            r_de_load_sext   = 0;
            r_de_wb_type = 0 as WbType;
        } else {
            if !w_d_stall && !w_de_flush {
                r_de_log = w_d_log;
                r_de_branch_instr = w_d_branch_instr;
                r_de_branch_type = w_d_branch_type;
                r_de_instr_valid = w_fd_instr_valid;
                r_de_pc          = w_fd_pc;
                r_de_instr       = w_fd_instr;
                r_de_rs1     = w_d_rs1;
                r_de_rs2     = w_d_rs2;
                r_de_reg_rs1     = r_regfile[w_d_rs1];
                r_de_reg_rs2     = r_regfile[w_d_rs2];
                r_de_imm         = w_d_imm;
                r_de_src2_reg    = w_d_src2_reg;
                r_de_alu_cmd     = w_d_alu_cmd;
                r_de_load_instr = w_d_load_instr;
                r_de_dmem_access = w_d_dmem_access;
                r_de_dmem_wen    = w_d_dmem_wen;
                r_de_imem_wen    = w_d_imem_wen;
                r_de_mem_wstrb   = w_d_mem_wstrb;
                r_de_io_access   = w_d_io_access;
                r_de_io_wen      = w_d_io_wen;
                r_de_rd          = w_d_rd;
                r_de_reg_wen     = w_d_reg_wen;
                r_de_load_en     = w_d_load_en;
                r_de_load_width  = w_d_load_width;
                r_de_load_sext   = w_d_load_sext;
                r_de_wb_type = w_d_wb_type;
            } else if w_de_flush {
                r_de_log = '0;
                r_de_branch_instr = 0;
                r_de_branch_type = 0 as BranchType;
                r_de_instr_valid = 0;
                r_de_pc          = 0;
                r_de_instr       = 0;
                r_de_reg_rs1     = 0;
                r_de_reg_rs2     = 0;
                r_de_imm         = 0;
                r_de_src2_reg    = 0;
                r_de_alu_cmd     = 0 as AluCmd;
                r_de_load_instr = 0;
                r_de_dmem_access = 0;
                r_de_dmem_wen    = 0;
                r_de_imem_wen    = 0;
                r_de_mem_wstrb   = 0;
                r_de_io_access   = 0;
                r_de_io_wen      = 0;
                r_de_rd          = 0;
                r_de_reg_wen     = 0;
                r_de_load_en     = 0;
                r_de_load_width  = 0;
                r_de_load_sext   = 0;
                r_de_wb_type = 0 as WbType;
            }
        }
    }

    // Execute Stage -----------------
    inst execute_stage: Execute (
        i_clk  ,
        i_rst  ,
        // controll
        i_me_rs1_forward: w_me_rs1_forward,
        i_me_rs2_forward: w_me_rs2_forward,
        i_we_rs1_forward: w_we_rs1_forward,
        i_we_rs2_forward: w_we_rs2_forward,

        // fetch stage
        o_pc_target: w_ef_pc_target,
        o_branch_taken: _w_ef_branch_taken,

        // decode stage
        i_reg_rs1 : r_de_reg_rs1 ,
        i_reg_rs2 : r_de_reg_rs2 ,
        i_imm     : r_de_imm     ,
        i_src2_reg: r_de_src2_reg,
        i_alu_cmd : r_de_alu_cmd ,
        i_branch_type: r_de_branch_type,
        i_pc : r_de_pc,

        // mem access stage
        i_m_result: r_em_alu_out,
        o_alu_out : w_e_alu_out ,
        o_alu_zero: w_e_alu_zero,

        // writeback stage
        i_w_result: w_w_reg_wdata,
    );
    always_ff (i_clk, i_rst) {
        if_reset {
            r_em_log = '0;
            r_em_instr_valid = 0;
            r_em_pc          = 0;
            r_em_instr       = 0;
            r_em_alu_out     = 0;
            r_em_alu_zero    = 0;
            r_em_dmem_access = 0;
            r_em_dmem_wen    = 0;
            r_em_imem_wen    = 0;
            r_em_mem_wstrb   = 0;
            r_em_io_access   = 0;
            r_em_io_wen      = 0;
            r_em_reg_rs2     = 0;
            r_em_rs2 = 0;
            r_em_rd          = 0;
            r_em_reg_wen     = 0;
            r_em_load_en     = 0;
            r_em_load_width  = 0;
            r_em_load_sext   = 0;
            r_em_load_instr = 0;
            r_em_wb_type = 0 as WbType;
        } else {
            if !w_e_stall {
                r_em_log = r_de_log;
                r_em_instr_valid = r_de_instr_valid;
                r_em_pc          = r_de_pc;
                r_em_instr       = r_de_instr;
                r_em_alu_out     = w_e_alu_out;
                r_em_alu_zero    = w_e_alu_zero;
                r_em_dmem_access = r_de_dmem_access;
                r_em_dmem_wen    = r_de_dmem_wen;
                r_em_imem_wen    = r_de_imem_wen;
                r_em_mem_wstrb   = r_de_mem_wstrb;
                r_em_io_access   = r_de_io_access;
                r_em_io_wen      = r_de_io_wen;
                r_em_reg_rs2     = r_de_reg_rs2;
                r_em_rs2 = r_de_rs2;
                r_em_rd          = r_de_rd;
                r_em_reg_wen     = r_de_reg_wen;
                r_em_load_en     = r_de_load_en;
                r_em_load_width  = r_de_load_width;
                r_em_load_sext   = r_de_load_sext;
                r_em_load_instr = r_de_load_instr;
                r_em_wb_type = r_de_wb_type;
            }
        }
    }

    // Memory Access Stage -----------
    // dcache.ready が立ってなければ WB でストール
    // inst mem_access_stage: MemAccess;
    inst m_dcache_mod: DCacheSplitAccess (
        i_clk       : i_clk        ,
        i_rst       : i_rst        ,
        core_if     : dcache_if    ,
        mem_read_if : dmem_read_if ,
        mem_write_if: dmem_write_if,
    );
    always_comb {
        o_dev_id = r_em_alu_out as Addr;
        dcache_if.valid = r_em_dmem_access && r_em_instr_valid;
        dcache_if.addr  = r_em_alu_out;
        dcache_if.wen   = r_em_dmem_wen;
        dcache_if.wstrb = r_em_mem_wstrb;
        if w_wm_rs2_forward {
            dcache_if.wdata = w_w_reg_wdata;
        } else {
            dcache_if.wdata = r_em_reg_rs2;
        }
        w_mw_read_data  = dcache_if.rdata;
    }
    always_ff (i_clk, i_rst) {
        if_reset {
            r_mw_log = '0;
            r_mw_instr_valid = 0;
            r_mw_pc          = 0;
            r_mw_instr       = 0;
            r_mw_alu_out     = 0;
            r_mw_rd          = 0;
            r_mw_reg_wen     = 0;
            r_mw_load_en     = 0;
            r_mw_load_width  = 0;
            r_mw_load_sext   = 0;
            r_mw_load_instr = 0;
            r_mw_wb_type = 0 as WbType;
        } else {
            if !w_m_stall && !w_mw_flush {
                r_mw_log.pc = r_em_log.pc;
                r_mw_log.instr = r_em_log.instr;
                r_mw_log.inst_type = r_em_log.inst_type;
                r_mw_log.dest_reg = r_em_log.dest_reg;
                r_mw_log.addr = case r_em_log.inst_type {
                    log_pkg::InstType::MEM_WRITE, 
                    log_pkg::InstType::MEM_READ,
                    log_pkg::InstType::DEV_READ,
                    log_pkg::InstType::DEV_WRITE,
                    log_pkg::InstType::IMEM_WRITE: dcache_if.addr,
                    default: 0,
                };
                r_mw_log.data = case r_em_log.inst_type {
                    log_pkg::InstType::MEM_WRITE, 
                    log_pkg::InstType::DEV_WRITE,
                    log_pkg::InstType::IMEM_WRITE: dcache_if.wdata,
                    default: 0,
                };
                r_mw_instr_valid = r_em_instr_valid;
                r_mw_pc          = r_em_pc;
                r_mw_instr       = r_em_instr;
                r_mw_alu_out     = r_em_alu_out;
                r_mw_rd          = r_em_rd;
                r_mw_reg_wen     = r_em_reg_wen;
                r_mw_load_en     = r_em_load_en;
                r_mw_load_width  = r_em_load_width;
                r_mw_load_sext   = r_em_load_sext;
                r_mw_load_instr = r_em_load_instr;
                r_mw_wb_type = r_em_wb_type;
            } else if w_mw_flush {
                r_mw_log = '0;
                r_mw_instr_valid = 0;
                r_mw_pc          = 0;
                r_mw_instr       = 0;
                r_mw_alu_out     = 0;
                r_mw_rd          = 0;
                r_mw_reg_wen     = 0;
                r_mw_load_en     = 0;
                r_mw_load_width  = 0;
                r_mw_load_sext   = 0;
                r_mw_load_instr = 0;
                r_mw_wb_type = 0 as WbType;
            }
        }
    }

    // Writeback Stage ---------------
    inst writeback_stage: Writeback (
        i_dev_din_data: if_io_bus_din.bits,
        i_load_data : w_mw_read_data ,
        i_load_width: r_mw_load_width,
        i_load_sext : r_mw_load_sext ,
        i_alu_out   : r_mw_alu_out   ,
        i_pc : r_mw_pc,
        i_wb_type: r_mw_wb_type,
        o_reg_wdata : w_w_reg_wdata  ,
    );
    always_comb {
        w_w_log.pc = r_mw_log.pc;
        w_w_log.instr = r_mw_log.instr;
        w_w_log.inst_type = r_mw_log.inst_type;
        w_w_log.dest_reg = r_mw_log.dest_reg;
        w_w_log.addr = r_mw_log.addr;
        w_w_log.data = case r_mw_log.inst_type {
            log_pkg::InstType::MEM_READ,
            log_pkg::InstType::DEV_READ,
            log_pkg::InstType::REG_WRITE: w_w_reg_wdata,
            default: r_mw_log.data,
        };
    }
    #[allow(missing_reset_statement)]
    always_ff (i_clk, i_rst) {
        if_reset {} else {
            if !w_m_stall {
                if r_mw_instr_valid && r_mw_reg_wen {
                    r_regfile[r_mw_rd] = w_w_reg_wdata;
                }
            }
        }
    }
    // ログ出力
    if TRACE_DUMP == 1 :l_trace_dump {
        var fd: u32;
        embed (inline) sv{{{
            string uuid;
            string path;
            initial begin
                // veryl は実行時に生成したファイルを一時ディレクトリに置き、
                // 一時ディレクトリは実行後に削除される。
                // 削除されない場所に出力するため、絶対パスで出力先を指定する。
                // また、verylは各 testcase で、(testcaseの依存関係にないものを含め)全モジュールの評価を行う。
                // このため、複数の testcase が走るとログファイルが上書きされてしまう。
                // 実行ごとに違うファイルに出力するため、uuidを付与する。
                fd = $fopen("/proc/sys/kernel/random/uuid", "r");
                $fscanf(fd, "%s", uuid);
                $fclose(fd);
                path = {"/tmp/trace-", uuid, ".log"};
                fd = $fopen(path, "w");
                $display("Trace log output to %s", path);
            end
        }}}
        always_ff (i_clk, i_rst) {
            if_reset {} else {
                if !w_m_stall && r_mw_instr_valid {
                    $fdisplay(fd, "%s", log_pkg::to_log_string(w_w_log));
                }
            }
        }
    }
}
