#[test(icache_tb)]
embed (inline) sv{{{
    module icache_tb();
        import \{ Config \}::*;
        import \{ axi_pkg \}::*;

        localparam int HOLD = 5;
        localparam int STEP = 20;

        localparam int CACHE_HIT_LATENCY = 2;
        localparam int CACHE_MISS_LATENCY = 4;

        \{ core_icache_if \} core_if();
        \{ axi_read_if \} #(
            .Addr(Addr),
            .Data(logic[31:0])
        ) mem_if();


        logic i_clk;
        logic i_rst;

        task next_cycle();
            #(HOLD);
            @(posedge i_clk);
            #(HOLD);
        endtask

        \{ ICacheSplitAccessWrapper \} icache(
            .i_clk,
            .i_rst,
            .core_if_addr (core_if.addr),
            .core_if_instr_valid (core_if.instr_valid),
            .core_if_instr (core_if.instr),
            .mem_if_arvalid  (mem_if.arvalid),
            .mem_if_arready  (mem_if.arready),
            .mem_if_araddr   (mem_if.araddr ),
            .mem_if_arid    (mem_if.arid   ),
            .mem_if_arlen   (mem_if.arlen  ),
            .mem_if_arsize  (mem_if.arsize ),
            .mem_if_arburst (mem_if.arburst),
            .mem_if_rvalid  (mem_if.rvalid ),
            .mem_if_rready  (mem_if.rready ),
            .mem_if_rdata   (mem_if.rdata  ),
            .mem_if_rid     (mem_if.rid    ),
            .mem_if_rresp   (mem_if.rresp  ),
            .mem_if_rlast   (mem_if.rlast  )
        );
        \{ AxiRam \} axi_ram (
            .i_clk          (i_clk         ),
            .i_rst          (i_rst         ),
            .mem_if_arvalid  (mem_if.arvalid),
            .mem_if_arready  (mem_if.arready),
            .mem_if_araddr   (mem_if.araddr ),
            .mem_if_arid    (mem_if.arid   ),
            .mem_if_arlen   (mem_if.arlen  ),
            .mem_if_arsize  (mem_if.arsize ),
            .mem_if_arburst (mem_if.arburst),
            .mem_if_rvalid  (mem_if.rvalid ),
            .mem_if_rready  (mem_if.rready ),
            .mem_if_rdata   (mem_if.rdata  ),
            .mem_if_rid     (mem_if.rid    ),
            .mem_if_rresp   (mem_if.rresp  ),
            .mem_if_rlast   (mem_if.rlast  )
        );

        Id w_id;
        Resp w_resp;
        Addr w_addr;
        Burst w_burst;
        Size w_size;
        Len w_len;

        initial begin
            $display("Starting test...");
            i_clk = 0;
            i_rst = 1;

            core_if.addr = '0;
            mem_if.arready = 0;
            mem_if.rvalid = 0;
            mem_if.rdata = '0;
            mem_if.rlast = '0;
            mem_if.rresp = Resp_OKAY;
            mem_if.rid = '0;

            repeat (2) next_cycle();
            $display("reset done");

            i_rst = 0;
            core_if.addr = '0; // miss アクセス
            next_cycle();
            core_if.addr = 4; // hit するアクセス
            while (!core_if.instr_valid) next_cycle();
            assert(core_if.instr == {16'hBE02, 32'hDEAD_BE01}) else $error("Instruction0 mismatch!: %h", core_if.instr);
            next_cycle();

            core_if.addr = LINE_SIZE_BYTES - 4; // cross boundary なアクセス
            assert(core_if.instr_valid) else $error("Instruction not valid!");
            assert(core_if.instr == {16'hBE03, 32'hDEAD_BE02}) else $error("Instruction1 mismatch!: %h", core_if.instr);
            next_cycle();

            // 1ライン目は hit
            next_cycle();
            // assert(icache.icache_split_access.w_next_instr == {16'h0, 32'hDEAD_BEEF + 32'd7}) else $error("First part mismatch!: %h", icache.icache_split_access.w_next_instr);
            // 2ライン目を返す
            while (!core_if.instr_valid) next_cycle();
            assert(core_if.instr == 48'hBE01_DEAD_BE08) else $error("Instruction2 mismatch!: %h", core_if.instr);

            next_cycle();
            $display("Test passed!");
            
            $finish;
        end

        always #STEP i_clk = ~i_clk;

        initial begin
            repeat(1000) @(posedge i_clk);
            $finish();
        end

    endmodule
}}}
