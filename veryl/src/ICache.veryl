/// 命令キャッシュ
///
/// - N way set associative cache
/// - write back
/// - pLRU
/// - 1 line = 64B (16 banks)
/// - 1 bank = 4B
/// - In-order queue
///
/// ```wavedrom
/// {
///     signal: [
///         {name: 'i_clk',       wave: 'p...........'},
///         {name: 'o_req_ready', wave: '1.0...10101.'},
///         {name: 'i_req_valid', wave: '0101.....0..'},
///         {name: 'i_req_addr',  wave: 'x=x=...=.x..', data: ['addr[0]', 'addr[1]', 'addr[2]']},
///         {},
///         {name: 'o_rep_valid', wave: '0.....101010'},
///         {name: 'o_rep_data',  wave: 'x.....=x=x=x', data: ['data[0]', 'data[1]', 'data[2]']},
///         {name: 'i_rep_ready', wave: '01.........0'},
///         {},
///         {name: 'state',       wave: 'x===..=====.', data: ['IDLE', 'CHECK', 'WAIT', 'IDLE', 'CHECK', 'IDLE', 'CHECK', 'IDLE']},
///         {name: 'r_tag',       wave: 'x.2x...2x2x.'},
///         {name: 'w_hit',       wave: 'x.0x...1x1x.'},
///         {name: 'r_data',      wave: 'x.2x...2x2x.'},
///         {},
///         {name: 'o_mem_valid', wave: '0..10.......'},
///         {name: 'o_mem_addr',  wave: 'x..=x.......', data: ['addr[0]']},
///         {name: 'i_mem_ready', wave: '1...01......'},
///         {},
///         {name: 'o_mrd_ready', wave: '0..1..0.....'},
///         {name: 'i_mrd_valid', wave: '0....10.....'},
///         {name: 'i_mrd_data',  wave: 'x....=x.....', data: ['data[0]']},
///     ],
///     config: { hscale: 2 }
/// }
/// ```

pub module ICache #(
    param ADDR_WIDTH: u32  = 32                             ,
    param Addr      : type = logic<ADDR_WIDTH>              ,
    param INST_WIDTH: u32  = 48                             ,
    param Inst      : type = logic<INST_WIDTH>              ,
    param LINE_WIDTH: u32  = 16 * 8                         ,
    param Line      : type = logic<LINE_WIDTH>              ,
    param CAPACITY  : u32  = 4096                           ,
    param WAY_NUM   : u32  = 1                              ,
    param SET_NUM   : u32  = CAPACITY / LINE_WIDTH / WAY_NUM,
) (
    i_clk: input clock,
    i_rst: input reset,

    // Interface to CPU
    if_cpu : modport $std::axi4_lite_if::<$std::axi4_lite_pkg::<32, 6, 8>>::slave,
    i_flush: input   logic                                                       ,

    // Interface to Memory
    if_mem: modport $std::axi4_lite_if::<$std::axi4_lite_pkg::<32, 16, 8>>::master,
) {
    // Addr = Tag + SetIndex + LineOffset
    type LineOffset = logic<$clog2(LINE_WIDTH)>                                                 ;
    type SetIndex   = logic<$clog2(SET_NUM / WAY_NUM)>                                          ;
    type Tag        = logic<$bits(Addr) - $bits(LineOffset) - $bits(SetIndex) - $clog2(WAY_NUM)>;

    const WayIndexWidth: u32                  = if WAY_NUM >: 1 ? $clog2(WAY_NUM) : 1;
    type WayIndex      = logic<WayIndexWidth>;

    // useful functions
    function line_offset (
        i_addr: input Addr,
    ) -> LineOffset {
        return i_addr[0+:$bits(LineOffset)];
    }
    function set_index (
        i_addr: input Addr,
    ) -> SetIndex {
        return i_addr[$bits(LineOffset)+:$bits(SetIndex)];
    }
    function tag (
        i_addr: input Addr,
    ) -> Tag {
        return i_addr[$bits(Addr) - 1-:$bits(Tag)];
    }

    // Data/Tag Array アクセス用
    var w_check_addr      : logic<$clog2(SET_NUM)>          ;
    var w_check_we        : logic<WAY_NUM>                  ;
    var w_check_wline     : Line                            ;
    var w_check_wtag      : Tag                             ;
    var w_check_wtag_valid: logic                           ;
    var w_check_tags      : Tag                    [WAY_NUM];
    var w_check_tag_valids: logic<WAY_NUM>                  ;
    var w_check_lines     : Line                   [WAY_NUM];
    var w_check_data      : Inst                   [WAY_NUM];

    // ヒット判定用
    var w_check_hit    : logic   ;
    var w_check_hit_way: WayIndex;

    enum State: logic<3> {
        IDLE,
        CHECK,
        MEM_REQ,
        MEM_WAIT,
        RESP,
    }
    var r_state     : State;
    var w_next_state: State;

    // コントローラー用バッファ
    var r_addr     : Addr;
    var w_addr_next: Addr;

    var r_data_buf     : Inst;
    var w_data_buf_next: Inst;


    // Data/Tag Array のインスタンス化
    for i in 0..WAY_NUM :way_loop {
        inst data_array: DataArray #(
            DATA_WIDTH: LINE_WIDTH,
            DEPTH     : SET_NUM   ,
        ) (
            i_clk  : i_clk           ,
            i_rst  : i_rst           ,
            i_we   : w_check_we[i]   , // refill 時に書き込み
            i_addr : w_check_addr    ,
            i_wline: w_check_wline   , // refill 時に書き込み
            o_rline: w_check_lines[i],
        );

        inst tag_array: TagArray #(
            TAG_W: $bits(Tag),
            DEPTH: SET_NUM   ,
        ) (
            i_clk      : i_clk  ,
            i_rst      : i_rst  ,
            i_tag_flush: i_flush, // キャッシュ全体のフラッシュ時に有効

            i_we        : w_check_we[i]        , // refill 時に書き込み
            i_addr      : w_check_addr         ,
            i_wtag      : w_check_wtag         , // refill 時に書き込み
            i_wtag_valid: w_check_wtag_valid   , // refill 時に書き込み
            o_rtag      : w_check_tags[i]      ,
            o_rtag_valid: w_check_tag_valids[i],
        );
    }

    always_comb {
        w_next_state    = r_state;
        w_addr_next     = r_addr;
        w_data_buf_next = r_data_buf;

        if_cpu.arready = 0;
        if_cpu.rvalid  = 0;
        if_cpu.rdata   = 0;

        if_mem.arvalid = 0;
        if_mem.araddr  = 0;
        if_mem.rready  = 0;

        w_check_hit     = 0;
        w_check_hit_way = 0;

        w_check_addr  = 0;
        w_check_we    = 0;
        w_check_wline = 0;
        w_check_wtag  = 0;

        for i: u32 in 0..WAY_NUM {
            w_check_data[i] = 0;
        }

        case (r_state) {
            State::IDLE: {
                if_cpu.arready = 1;
                if if_cpu.araddr_ack() {
                    w_next_state = State::CHECK;
                    w_addr_next  = if_cpu.araddr;
                    w_check_addr = set_index(if_cpu.araddr);
                    for i: u32 in 0..WAY_NUM {
                        w_check_we[i] = 0; // 読み込み
                    }
                }
            }
            State::CHECK: {
                // チェック
                w_check_hit = 0;
                for i: u32 in 0..WAY_NUM {
                    if (w_check_tag_valids[i] && (w_check_tags[i] == tag(r_addr))) {
                        w_check_hit     = 1;
                        w_check_hit_way = i as WayIndex;
                        break;
                    }
                }

                for i: u32 in 0..WAY_NUM {
                    w_check_data[i] = w_check_lines[i][line_offset(r_addr)+:INST_WIDTH];
                }

                if (w_check_hit) {
                    // ヒット
                    if if_cpu.rready {
                        w_next_state    = State::RESP;
                        w_data_buf_next = w_check_data[w_check_hit_way];
                    }
                } else {
                    // ミス
                    w_next_state = State::MEM_REQ;
                }
            }
            State::MEM_REQ: {
                if_mem.arvalid = 1;
                if_mem.araddr  = {tag(r_addr), set_index(r_addr), 0 as LineOffset};

                if if_mem.araddr_ack() {
                    w_next_state = State::MEM_WAIT;
                }
            }
            State::MEM_WAIT: {
                if_mem.rready = 1;
                if if_mem.rdata_ack() {
                    w_next_state    = State::IDLE;
                    w_data_buf_next = if_mem.rdata[line_offset(r_addr)+:INST_WIDTH];
                    w_check_we[0]   = 1; // リフィル
                    w_check_addr    = set_index(r_addr);
                    w_check_wline   = if_mem.rdata;
                    w_check_wtag    = tag(r_addr);
                }
            }
            State::RESP: {
                if_cpu.rvalid = 1;
                if_cpu.rdata  = r_data_buf;

                if if_cpu.rdata_ack() {
                    w_next_state = State::IDLE;
                }
            }
        }

    }

    // ステートマシン の更新
    always_ff (i_clk, i_rst) {
        if_reset {
            r_state    = State::IDLE;
            r_addr     = 0;
            r_data_buf = 0;
        } else {
            r_state    = w_next_state;
            r_addr     = w_addr_next;
            r_data_buf = w_data_buf_next;
        }
    }
}
