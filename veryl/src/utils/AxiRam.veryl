// シミュレーション用のAXI RAMモジュール
// 実際に合成するとクソデカRAMが合成される可能性が高いので注意
module AxiRam #(
    param DEPTH: u32 = 1024,
) (
    i_clk         : input  clock    ,
    i_rst         : input  reset    ,
    mem_if_arvalid: input  logic    ,
    mem_if_arready: output logic    ,
    mem_if_araddr : input  Addr     ,
    mem_if_arid   : input  Id       ,
    mem_if_arlen  : input  Len      ,
    mem_if_arsize : input  Size     ,
    mem_if_arburst: input  Burst    ,
    mem_if_rvalid : output logic    ,
    mem_if_rready : input  logic    ,
    mem_if_rdata  : output logic<32>,
    mem_if_rid    : output Id       ,
    mem_if_rresp  : output Resp     ,
    mem_if_rlast  : output logic    ,
) {
    import axi_pkg::*;
    import Config::*;

    var r_mem: logic<8> [DEPTH];

    var r_arready: logic                     ;
    var r_rvalid : logic                     ;
    var r_data   : logic<$bits(mem_if_rdata)>;
    var r_len    : Len                       ;
    var r_len_cnt: Len                       ;
    var r_addr   : Addr                      ;

    always_comb {
        mem_if_arready = r_arready;
        mem_if_rvalid  = r_rvalid;
        mem_if_rdata   = r_data;
        mem_if_rid     = '0;
        mem_if_rresp   = Resp::OKAY;
        mem_if_rlast   = (r_len == r_len_cnt) && r_rvalid;
    }

    always_ff (i_clk, i_rst) {
        if_reset {
            for i: u32 in 0..DEPTH / 4 {
                r_mem[i * 4 + 0] = i as 8;
                r_mem[i * 4 + 1] = 8'hBE;
                r_mem[i * 4 + 2] = 8'hAD;
                r_mem[i * 4 + 3] = 8'hDE;
            }
            r_data    = 0;
            r_rvalid  = 0;
            r_arready = 1;
            r_len     = 0;
        } else {
            if (mem_if_arvalid && r_arready) {
                r_rvalid = 1;
                if mem_if_arlen != 0 {
                    r_arready = 0;
                    r_len     = mem_if_arlen;
                    r_len_cnt = 0;
                    r_addr    = mem_if_araddr;
                }
                for i: u32 in 0..8 {
                    r_data[i * 8+:8] = r_mem[mem_if_araddr as u32 + i];
                }
            }
            if (mem_if_rready && r_rvalid && mem_if_rlast) {
                r_rvalid = mem_if_arvalid && r_arready;
            } else if (mem_if_rready && r_rvalid) {
                r_rvalid = 1;
                for i: u32 in 0..8 {
                    r_data[i * 8+:8] = r_mem[r_addr as u32 + i + (r_len_cnt as u32 + 1) * 4];
                }
                r_len_cnt += 1;
                r_arready =  1;
            }
        }
    }
}
