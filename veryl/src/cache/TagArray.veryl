module TagArray (
    i_clk: input clock,
    i_rst: input reset,

    i_set: input  ICacheSet,
    i_we : input  logic    ,
    i_tag: input  ICacheTag,
    o_tag: output ICacheTag,

    // refill request
) {
    import Config::*;

    struct Meta {
        valid: logic    ,
        tag  : ICacheTag,
    }
    // cycle 0
    var w_set       : ICacheSet;
    var w_write_meta: Meta     ;

    // cycle 1
    var w_read_meta: Meta;

    always_comb {
        w_set              = i_set;
        w_write_meta.valid = 1;
        w_write_meta.tag   = i_tag;

        o_tag = w_read_meta.tag;
    }

    inst meta_array: Ram #(
        DataType: Meta     ,
        AddrType: ICacheSet,
    ) (
        i_clk: i_clk,
        i_rst: i_rst,

        i_addr: w_set       ,
        i_we  : i_we        ,
        i_data: w_write_meta,
        o_data: w_read_meta ,
    );
}
