module ICache (
    i_clk: input clock,
    i_rst: input reset,

    // read request
    i_addr_valid : input logic,
    o_addr_ready : output logic,
    i_addr : input Addr,
    o_inst : output Inst,
    o_valid : output logic,

    // memory interface
    o_arvalid : output logic,
    o_araddr : output Addr,
    i_arready : input logic,

    i_rvalid : input logic,
    i_rdata : input Line,
    o_rready : output logic,
) {
    import Config::*;

    enum MissState: logic<2> {
        IDLE,
        REQ_MEM,
        RESP_MEM,
    }

    var r_miss_state : MissState;
    var w_miss_state_next : MissState;

    // cycle 0
    var w_set : ICacheSet;

    // cycle 1
    var r_valid : logic;
    var w_hit : logic;
    var w_line : Line;
    var r_addr : Addr;
    var w_busy : logic;
    var w_inst : Inst;

    // output cycle
    var r_out_inst : Inst;
    var r_out_valid : logic;
    var w_out_valid_next : logic;

    // cycle 2..
    var r_arready : logic;
    var r_arvalid : logic;
    var w_we : logic;
    var w_write_tag : ICacheTag;
    var w_write_line : Line;

    inst tag_array: TagArray (
        i_clk : i_clk,
        i_rst : i_rst,
        
        i_addr : i_addr,
        i_we   : w_we,
        i_tag  : w_write_tag,
        o_hit  : w_hit,
        o_tag  : _,
    );
    inst data_array: DataArray (
        i_clk : i_clk,
        i_rst : i_rst,

        i_addr : w_set,
        i_we   : w_we,
        i_line : w_write_line,
        o_line : w_line,
    );

    always_comb {
        w_set = GetICacheSet(i_addr);
        w_inst = case (r_miss_state) {
            MissState::IDLE: w_line[GetLineOffset(r_addr) * 8 +: $bits(Inst)],
            MissState::RESP_MEM: i_rdata[GetLineOffset(r_addr) * 8 +: $bits(Inst)],
            default: 0,
        };
        o_inst = r_out_inst;
        w_busy = r_valid && !w_hit;
        o_valid = r_out_valid;

        o_addr_ready = 0;
        o_araddr = r_addr;
        o_arvalid = 0;
        o_rready = 0;
        w_we = 0;
        w_write_tag = GetICacheTag(r_addr);
        w_write_line = i_rdata;
        w_out_valid_next = 0;
        w_miss_state_next = MissState::IDLE;
        case (r_miss_state) {
            MissState::IDLE: {
                if (w_busy) {
                    w_miss_state_next = MissState::REQ_MEM;
                    o_arvalid = 1;
                    o_araddr = r_addr;
                } else {
                    w_miss_state_next = MissState::IDLE;
                    o_addr_ready = 1;
                    w_out_valid_next = r_valid;
                }
            }
            MissState::REQ_MEM: {
                if (r_arready && r_arvalid) {
                    w_miss_state_next = MissState::RESP_MEM;
                    o_rready = 1;
                } else {
                    w_miss_state_next = MissState::REQ_MEM;
                }
            }
            MissState::RESP_MEM: {
                o_rready = 1;
                if (i_rvalid && o_rready) {
                    w_miss_state_next = MissState::IDLE;
                    w_out_valid_next = 1;
                    w_we = 1;
                } else {
                    w_miss_state_next = MissState::RESP_MEM;
                }
            }
            default: {
                w_miss_state_next = MissState::IDLE;
            }
        }
    }

    always_ff (i_clk, i_rst) {
        if_reset {
            r_addr = 0;
            r_miss_state = MissState::IDLE;
            r_valid = 0;
            r_arready = 0;
            r_arvalid = 0;
            r_out_valid = 0;
        } else {
            r_addr = i_addr;
            r_miss_state = w_miss_state_next;
            r_valid = i_addr_valid && o_addr_ready;
            r_arready = i_arready;
            r_arvalid = o_arvalid;
            r_out_valid = w_out_valid_next;
            r_out_inst = w_inst;
        }
    }

}
