module ICacheController (
    i_clk: input clock,
    i_rst: input reset,

    i_valid: input logic,
    i_hit  : input logic,
    i_addr : input Addr ,

    o_stall   : output logic,
    o_array_we: output logic,
    o_line    : output Line ,


    // memory interface
    mem_if: modport axi_read_if::master,
) {
    import Config::*;

    // メモリに対して 32bit ずつ、 $bits(Line)/32bit 回アクセスしてラインを取得する。
    const BEAT_MAX          : u32 = $bits(Line) / 32;
    const BEAT_COUNTER_WIDTH: u32 = $clog2(BEAT_MAX);

    var r_array_we    : logic                    ;
    var r_busy        : logic                    ;
    var r_line_buffer : Line                     ;
    var r_beat_counter: logic<BEAT_COUNTER_WIDTH>;

    enum State {
        IDLE,
        FETCH,
        REFILL,
        READ,
    }

    var r_state: State;

    always_comb {
        o_stall    = i_valid & !i_hit | r_busy;
        o_line     = r_line_buffer;
        o_array_we = r_array_we;
    }

    always_ff (i_clk, i_rst) {
        if_reset {
            r_line_buffer  = '0;
            r_beat_counter = '0;
            r_state        = State::IDLE;
            r_array_we     = 0;
            r_busy         = 0;

            mem_if.araddr  = '0;
            mem_if.arvalid = 0;
            mem_if.rready  = 0;
        } else {
            case (r_state) {
                // ミス時、メモリに対してラインを要求
                State::IDLE: {
                    if (i_valid && !i_hit) {
                        r_state        = State::FETCH;
                        r_busy         = !i_hit;
                        r_beat_counter = '0;

                        // バースト転送の設定
                        // 32bit で BEAT_MAX 回の転送を連続で行う
                        // ラインの先頭アドレスから昇順に取得
                        mem_if.arvalid = 1;
                        mem_if.araddr  = i_addr;
                        mem_if.arsize  = 2;
                        mem_if.arlen   = (BEAT_MAX - 1) as axi_pkg::Len;
                        mem_if.arburst = axi_pkg::Burst::INCR;
                        mem_if.rready  = 1;
                    }
                }
                // バースト転送でラインを取得
                State::FETCH: {
                    if mem_if.arvalid && mem_if.arready {
                        mem_if.arvalid = 0;
                    }
                    if mem_if.rvalid && mem_if.rready {
                        // 4byte ずつラインバッファに格納
                        r_line_buffer[{r_beat_counter, 5'b0}+:32] = mem_if.rdata;
                        if !mem_if.rlast {
                            r_beat_counter += 1;
                        } else {
                            mem_if.rready  = 0;
                            r_beat_counter = 0;
                            r_state        = State::REFILL;
                            r_array_we     = 1;
                        }
                    }
                }
                // ラインのrefill
                State::REFILL: {
                    r_array_we = 0;
                    r_busy     = 0;
                    r_state    = State::READ;
                }
                // TagArray/DataArray の出力が hit 時と同じになるように、 refill したラインを読み出すサイクル
                State::READ: {
                    r_state = State::IDLE;
                }
            }
        }
    }

}
